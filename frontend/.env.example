# PayTrace AI — Frontend Environment Template
#
# LOCAL DEVELOPMENT
# -----------------
# `npm run dev` uses the Vite proxy in vite.config.js, so the browser
# calls /api on the same localhost port. No API URL is required here.
#
# DEPLOYMENT
# ----------
# For a separately hosted frontend/backend, set VITE_API_URL at build time:
#
# VITE_API_URL=https://api.your-paytrace.example.com
#
# IMPORTANT:
# VITE_* values are exposed to browser JavaScript.
# Never put Razorpay secret keys, webhook secrets, or AI API keys here.

VITE_API_URL=
