# PayTrace AI — Backend Environment Template
# Copy this file to backend/.env and replace placeholders.
# NEVER commit the real backend/.env.

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Explicit frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# For local Buildathon development, allow localhost/127.0.0.1 on
# any port so Vite can fall back from 5173 to 5174, 5175, etc.
ALLOW_LOCALHOST_CORS=true

# Optional AI explanation layer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
